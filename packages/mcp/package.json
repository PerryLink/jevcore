{
  "name": "jevcore-mcp",
  "version": "0.1.0",
  "description": "TypeSafe Jev over the Model Context Protocol: typed judgments (ask, rank, check) that return calibrated probabilities instead of prose.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jev",
    "typesafe",
    "typesafe-ai",
    "system-one",
    "decision-model"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/jevcore.git"
  },
  "bugs": {
    "url": "https://github.com/PerryLink/jevcore/issues"
  },
  "homepage": "https://github.com/PerryLink/jevcore#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "jevcore-mcp": "./lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/mcp-smoke.mjs",
    "smoke:live": "node scripts/mcp-smoke-live.mjs"
  },
  "dependencies": {
    "jevcore": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@openrouter/sdk": "^1.3.6"
  }
}
