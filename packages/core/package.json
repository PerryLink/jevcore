{
  "name": "@dsh-jev/core",
  "version": "0.1.0",
  "description": "Framework-agnostic TypeSafe Jev decision core: typed primitives, pluggable providers, an explicit egress contract, redaction, and local decision policy.",
  "keywords": [
    "jev",
    "typesafe",
    "typesafe-ai",
    "system-one",
    "decision-model",
    "classification",
    "noul",
    "choice",
    "score"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-jev/dsh-jev.git"
  },
  "bugs": {
    "url": "https://github.com/dsh-jev/dsh-jev/issues"
  },
  "homepage": "https://github.com/dsh-jev/dsh-jev#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:schemas": "node scripts/check-openrouter-schemas.mjs",
    "probe:live": "node scripts/probe-openrouter-live.mjs"
  },
  "optionalDependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "@openrouter/sdk": "^1.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
