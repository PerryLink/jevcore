node_modules/
lib/
coverage/
*.log
.DS_Store
.env
.env.local
*.tsbuildinfo
_probe.log

# Build output must never land beside its source. An inherited relative `outDir`
# once resolved against the declaring config and emitted declarations into
# `src/`, where 16 of them were committed before anyone noticed.
packages/*/src/**/*.d.ts
packages/*/src/**/*.js
packages/*/src/**/*.js.map